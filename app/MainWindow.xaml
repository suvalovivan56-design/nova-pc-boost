<Window x:Class="NovaPCBoost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOVA PC BOOST" Width="1420" Height="900" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource TextMain}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="246"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="True" Margin="17,20,17,16">
        <StackPanel DockPanel.Dock="Top" Margin="3,0,3,27">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="{StaticResource Accent}" CornerRadius="10" Width="42" Height="42">
              <TextBlock Text="N" Foreground="#080B10" FontSize="27" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="NOVA" FontSize="22" FontWeight="Black" Foreground="{StaticResource TextMain}"/>
              <TextBlock Text="PC OPTIMIZER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="1,0,0,0"/>
            </StackPanel>
          </StackPanel>
          <Border Background="#121D17" BorderBrush="#263D2B" BorderThickness="1" CornerRadius="8" Padding="11,10" Margin="0,19,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="SYSTEM STATUS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock Text="Локальная сессия активна" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="3,0,3,0">
          <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,14"/>
          <TextBlock Text="NOVA PC BOOST" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
          <TextBlock Text="v1.6.0  •  WINDOWS x64" FontSize="9" Foreground="#71808E" Margin="0,5,0,0"/>
          <TextBlock Text="Настройки хранятся локально" FontSize="9" Foreground="#71808E" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="РАБОЧАЯ ОБЛАСТЬ" Foreground="#71808E" FontSize="9" FontWeight="Bold" Margin="8,0,0,10"/>
          <Button x:Name="NavDashboard" Style="{StaticResource NavButton}" Content="▦    Панель управления" Click="Dashboard_Click"/>
          <Button x:Name="NavProfiles" Style="{StaticResource NavButton}" Content="◈    Игровые профили" Click="Profiles_Click"/>
          <Button x:Name="NavTweaks" Style="{StaticResource NavButton}" Content="⌁    Оптимизация Windows" Click="Tweaks_Click"/>
          <Button x:Name="NavTools" Style="{StaticResource NavButton}" Content="⚙    Системные инструменты" Click="Tools_Click"/>
          <Button x:Name="NavRestore" Style="{StaticResource NavButton}" Content="↶    Резервные копии и откат" Click="Restore_Click"/>
          <Border Height="1" Background="{StaticResource Line}" Margin="7,17,7,16"/>
          <TextBlock Text="БЫСТРЫЕ ПОДСКАЗКИ" Foreground="#71808E" FontSize="9" FontWeight="Bold" Margin="8,0,0,10"/>
          <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,8">
            <StackPanel>
              <TextBlock Text="01  ·  СНАЧАЛА БЭКАП" FontSize="9" Foreground="{StaticResource Accent}" FontWeight="Bold"/>
              <TextBlock Text="Сохрани исходные параметры перед изменениями." FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="11">
            <StackPanel>
              <TextBlock Text="02  ·  ТЕСТИРУЙ ПО ОДНОМУ" FontSize="9" Foreground="{StaticResource Cyan}" FontWeight="Bold"/>
              <TextBlock Text="Сравнивай FPS в одинаковых условиях." FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="28,21,28,17">
      <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/><RowDefinition Height="31"/></Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="Breadcrumb" Text="NOVA  /  ПАНЕЛЬ" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/>
          <TextBlock x:Name="PageTitle" Text="Состояние системы" FontSize="25" FontWeight="Bold" Margin="0,4,0,0"/>
        </StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="13,9">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="NATIVE WINDOWS APP" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/>
            <Border Background="#263D2B" CornerRadius="5" Padding="6,3" Margin="10,0,0,0">
              <TextBlock Text="v1.6.0" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold"/>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
      <Border Grid.Row="1" Background="#090E14" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="13" Padding="18,16">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="PageContent" Margin="0,0,5,12"/>
        </ScrollViewer>
      </Border>
      <Grid Grid.Row="2" Margin="0,7,0,0">
        <Border Height="1" Background="{StaticResource Line}" VerticalAlignment="Top"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
          <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,7,1"/>
          <TextBlock x:Name="StatusText" Text="ГОТОВ К РАБОТЕ" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/>
        </StackPanel>
        <TextBlock Text="Результат зависит от железа и настроек игры" Foreground="#71808E" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
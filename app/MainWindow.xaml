<Window x:Class="NovaPCBoost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOVA PC BOOST" Width="1440" Height="920" MinWidth="1060" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource TextMain}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        ResizeMode="CanResizeWithGrip">
  <Window.Resources>
    <LinearGradientBrush x:Key="SidebarGlow" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#121B13" Offset="0"/>
      <GradientStop Color="#0A0F0C" Offset="0.72"/>
      <GradientStop Color="#0B1017" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ContentGlow" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#111A13" Offset="0"/>
      <GradientStop Color="#0A0F0C" Offset="0.53"/>
      <GradientStop Color="#0B1118" Offset="1"/>
    </LinearGradientBrush>
  </Window.Resources>
  <Grid>
    <Grid.Background>
      <SolidColorBrush Color="#080B0D"/>
    </Grid.Background>
    <Ellipse Width="430" Height="430" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-260,-100,0" Fill="#223D28" Opacity="0.20" IsHitTestVisible="False"/>
    <Ellipse Width="300" Height="300" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="180,0,0,-210" Fill="#163C31" Opacity="0.12" IsHitTestVisible="False"/>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource SidebarGlow}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="True" Margin="16,17,16,15">
          <StackPanel DockPanel.Dock="Top" Margin="4,0,4,25">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Background="{StaticResource Accent}" CornerRadius="13" Width="45" Height="45">
                <Grid>
                  <TextBlock Text="N" Foreground="#080B10" FontSize="29" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,3,0"/>
                  <Border BorderBrush="#FFFFFF70" BorderThickness="1" CornerRadius="10" Margin="4"/>
                </Grid>
              </Border>
              <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="NOVA" FontSize="23" FontWeight="Black" Foreground="{StaticResource TextMain}"/>
                <TextBlock Text="PC PERFORMANCE LAB" FontSize="8" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="2,4,0,0"/>
              </StackPanel>
            </StackPanel>
            <Border Background="#111D14" BorderBrush="#314B31" BorderThickness="1" CornerRadius="15" Padding="12,11" Margin="0,20,0,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="17"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid Grid.Column="0" VerticalAlignment="Top" Margin="0,3,0,0">
                  <Ellipse Width="9" Height="9" Fill="#B8FF57" Opacity="0.20"/>
                  <Ellipse Width="5" Height="5" Fill="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="SYSTEM STATUS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                  <TextBlock Text="Локальная сессия активна" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="3,0,3,0">
            <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,13"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="NOVA PC BOOST" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                <TextBlock Text="WINDOWS · X64" FontSize="8" Foreground="#718078" Margin="0,5,0,0"/>
              </StackPanel>
              <Border Grid.Column="1" Background="#1C2B1D" BorderBrush="#354C34" BorderThickness="1" CornerRadius="7" Padding="7,4" VerticalAlignment="Center">
                <TextBlock Text="v1.7.0" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold"/>
              </Border>
            </Grid>
            <TextBlock Text="Настройки хранятся локально" FontSize="9" Foreground="#718078" Margin="0,9,0,0"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="WORKSPACE" Foreground="#6E7C70" FontSize="9" FontWeight="Bold" Margin="8,0,0,10"/>
            <Button x:Name="NavDashboard" Style="{StaticResource NavButton}" Content="▦    Панель управления" Click="Dashboard_Click"/>
            <Button x:Name="NavProfiles" Style="{StaticResource NavButton}" Content="◈    Игровые профили" Click="Profiles_Click"/>
            <Button x:Name="NavTweaks" Style="{StaticResource NavButton}" Content="⌁    Оптимизация Windows" Click="Tweaks_Click"/>
            <Button x:Name="NavTools" Style="{StaticResource NavButton}" Content="⚙    Системные инструменты" Click="Tools_Click"/>
            <Button x:Name="NavRestore" Style="{StaticResource NavButton}" Content="↶    Резервные копии и откат" Click="Restore_Click"/>
            <Border Height="1" Background="{StaticResource Line}" Margin="7,18,7,15"/>
            <TextBlock Text="QUICK NOTES" Foreground="#6E7C70" FontSize="9" FontWeight="Bold" Margin="8,0,0,10"/>
            <Border Background="#101711" BorderBrush="#2A3A2C" BorderThickness="1" CornerRadius="13" Padding="12" Margin="0,0,0,9">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="01" FontSize="9" Foreground="{StaticResource Accent}" FontWeight="Bold"/>
                  <TextBlock Text="   BACKUP FIRST" FontSize="9" Foreground="#D9E5D6" FontWeight="Bold"/>
                </StackPanel>
                <TextBlock Text="Сохрани исходные параметры перед изменениями." FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="15"/>
              </StackPanel>
            </Border>
            <Border Background="#101518" BorderBrush="#27363C" BorderThickness="1" CornerRadius="13" Padding="12">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="02" FontSize="9" Foreground="{StaticResource Cyan}" FontWeight="Bold"/>
                  <TextBlock Text="   TEST ONE BY ONE" FontSize="9" Foreground="#D9E5E2" FontWeight="Bold"/>
                </StackPanel>
                <TextBlock Text="Сравнивай FPS в одинаковых условиях." FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="15"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1" Margin="26,18,26,15">
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="1,0,1,11">
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="Breadcrumb" Text="NOVA  /  OVERVIEW" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/>
            <TextBlock x:Name="PageTitle" Text="Твой ПК. Твои правила." FontSize="27" FontWeight="Bold" Margin="0,3,0,0"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Border Background="#101712" BorderBrush="#2C3B2D" BorderThickness="1" CornerRadius="999" Padding="12,8" Margin="0,0,9,0">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                <TextBlock Text="LOCAL MODE" Foreground="#C3D1C1" FontSize="9" FontWeight="Bold"/>
              </StackPanel>
            </Border>
            <Border Background="#10161B" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="999" Padding="12,8">
              <TextBlock Text="NATIVE WINDOWS APP" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/>
            </Border>
          </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="{StaticResource ContentGlow}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="22" Padding="21,19">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="3"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="#263729" CornerRadius="2" HorizontalAlignment="Stretch" VerticalAlignment="Top">
              <Border Background="{StaticResource Accent}" CornerRadius="2" Width="94" Height="3" HorizontalAlignment="Left"/>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,13,3,0">
              <StackPanel x:Name="PageContent" Margin="0,0,5,12"/>
            </ScrollViewer>
          </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,7,0,0">
          <Border Height="1" Background="{StaticResource Line}" VerticalAlignment="Top"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
            <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,7,1"/>
            <TextBlock x:Name="StatusText" Text="ГОТОВ К РАБОТЕ" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/>
          </StackPanel>
          <TextBlock Text="CONTROL YOUR PC. TEST YOUR RESULTS." Foreground="#657366" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
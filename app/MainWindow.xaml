<Window x:Class="NovaPCBoost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOVA PC BOOST" Width="1260" Height="820" MinWidth="1050" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource TextMain}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="True" Margin="15,22,15,17">
        <StackPanel DockPanel.Dock="Top" Margin="5,0,5,30">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="{StaticResource Accent}" CornerRadius="9" Width="37" Height="37">
              <TextBlock Text="✳" Foreground="#080B10" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="NOVA" FontSize="20" FontWeight="Black" Foreground="{StaticResource TextMain}"/>
              <TextBlock Text="PC BOOST" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Accent}" CharacterSpacing="180"/>
            </StackPanel>
          </StackPanel>
          <Border Background="#142019" CornerRadius="7" Padding="10,8" Margin="0,19,0,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="WINDOWS GAMING TOOLKIT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="5,0,5,0">
          <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,13"/>
          <TextBlock Text="LOCAL SESSION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
          <TextBlock Text="v1.5.0  •  NATIVE WINDOWS" FontSize="9" Foreground="#71808E" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="WORKSPACE" Foreground="#71808E" FontSize="9" FontWeight="Bold" Margin="8,0,0,10"/>
          <Button x:Name="NavDashboard" Style="{StaticResource NavButton}" Content="◈    Обзор" Click="Dashboard_Click"/>
          <Button x:Name="NavProfiles" Style="{StaticResource NavButton}" Content="▦    Игровые профили" Click="Profiles_Click"/>
          <Button x:Name="NavTweaks" Style="{StaticResource NavButton}" Content="⌁    Твики Windows" Click="Tweaks_Click"/>
          <Button x:Name="NavTools" Style="{StaticResource NavButton}" Content="⚙    Инструменты" Click="Tools_Click"/>
          <Button x:Name="NavRestore" Style="{StaticResource NavButton}" Content="↶    Откат изменений" Click="Restore_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="28,20,28,15">
      <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="Breadcrumb" Text="NOVA  /  OVERVIEW" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/>
          <TextBlock x:Name="PageTitle" Text="Твой ПК. Твои правила." FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" Margin="0,0,8,0"/>
          <TextBlock Text="LOCAL SESSION" Foreground="{StaticResource Muted}" FontSize="9" FontWeight="Bold"/>
          <TextBlock Text="  │  " Foreground="{StaticResource Line}" Margin="8,0"/>
          <TextBlock Text="v1.5.0" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/>
        </StackPanel>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PageContent" Margin="0,7,6,15"/>
      </ScrollViewer>
      <Grid Grid.Row="2" Margin="0,5,0,0">
        <Border Height="1" Background="{StaticResource Line}" VerticalAlignment="Top"/>
        <TextBlock x:Name="StatusText" Text="ГОТОВ К РАБОТЕ" Foreground="#71808E" FontSize="9" FontWeight="Bold" VerticalAlignment="Bottom"/>
        <TextBlock Text="Результат зависит от железа и настроек игры" Foreground="#71808E" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
